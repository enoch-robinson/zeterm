# Rust 构建产物 (最重要)
/target/

# 环境变量文件 (绝对不能提交，包含密钥)
.env
!.env.example
.env.*

# 操作系统生成的临时文件
.DS_Store
Thumbs.db

# 编辑器配置 (可选，视团队习惯而定)
.idea/
.vscode/
*.swp
*.swo

# 备份文件
**/*.rs.bk

# 如果你不想提交 Cargo.lock，可以取消下面这行的注释
# (通常建议：开发 Application/服务时提交 Cargo.lock，开发 Library 时忽略)
# Cargo.lock

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Data directories (contains user data, sessions, etc.)
data/
**/data/


# Zed 编辑器配置
.zed/

**/*.log
